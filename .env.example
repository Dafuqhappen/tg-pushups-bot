# ─── обязательное ──────────────────────────────────────────────────────────
BOT_TOKEN=123456:your-telegram-bot-token
CHAT_ID=-1001234567890

# ─── правила челленджа ─────────────────────────────────────────────────────
TIMEZONE=Europe/Moscow
DAILY_GOAL=4

# Граница «логического дня»: кружок, отправленный до этого часа, засчитывается
# за предыдущий день. 6 — компромисс между ночной добивкой нормы (00–06 → вчера)
# и утренней тренировкой до работы (06–09 → сегодня).
DAY_CUTOFF_HOUR=6

# Час публикации ежедневной сводки за предыдущий логический день.
SUMMARY_HOUR=9

# С этой даты считаются стрики по правилу «один пропуск в месяц прощается».
SEASON_START=2026-06-01

# Каждые N дней подряд участник зарабатывает один день заморозки — им можно
# пропустить день, не потеряв стрик, когда месячный пропуск уже израсходован.
FREEZE_EVERY=30

# Вехи, за которые выдаются постоянные медали (считаются от рекорда).
MILESTONES=30,50,100,200,365

# Участники, которых бот не показывает в сводке и /top и которым не считает
# стрик (по их собственной просьбе). Кружки при этом пишутся как обычно.
# Формат: 111,222,333
EXCLUDED_USER_IDS=

# ─── хранилище ─────────────────────────────────────────────────────────────
DB_PATH=data/pushups.db

# ─── опциональное ──────────────────────────────────────────────────────────
# Прокси для исходящих запросов к api.telegram.org — нужен, только если
# провайдер блокирует Telegram. Для socks5 доустановить: pip install "httpx[socks]"
# TG_PROXY_URL=socks5://user:pass@host:1080

# Telethon — только для разового импорта истории чата (backfill.py).
# Получить api_id/api_hash: https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
TG_PHONE=
BACKFILL_SINCE=2026-04-01
